# Base URL of the BlockLog backend API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Optional: enables the Natural Language search tab. The key is kept
# server-side (never sent to the browser). Without this set, the NL tab
# explains it is not yet configured and defers to the structured form.
# The project is fully functional without it.
ANTHROPIC_API_KEY=

# Optional: override the language model used for NL query translation.
# Defaults to the value baked into the API route if not set.
LLM_MODEL=
