# Base URL of the BlockLog backend API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Optional: enables the Natural Language search tab. Without this set, that
# tab explains it is not yet configured and defers to the structured form.
# The project is fully functional without it. Production deployment would
# require moving this call server-side rather than exposing a key to the browser.
NEXT_PUBLIC_ANTHROPIC_API_KEY=

# Optional: override the language model used for NL query translation.
# Defaults to the value baked into use-nl-search.ts if not set.
NEXT_PUBLIC_LLM_MODEL=
